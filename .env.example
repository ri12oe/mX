# Copy to .env and fill in. Never commit .env.

# Your own key for calling the mX API (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MX_API_KEY=change-me-to-a-long-random-string

# Password for the web login page (at least 12 characters).
MX_PASSWORD=change-me-to-a-long-password

# From console.anthropic.com
ANTHROPIC_API_KEY=
PRIMARY_PROVIDER=anthropic
PRIMARY_MODEL=claude-opus-5-5

DB_PATH=./data/mx.db
SYSTEM_PROMPT_FILE=prompts/mx_system_v3.md
# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]
# Prompt-cache lifetime: 5m (default) or 1h (see docs/design.md section 15)
CACHE_TTL=5m
# Monthly API budget in USD: warning at 80%, brief mode with tools off at 100% (section 16)
MONTHLY_BUDGET_USD=20
